{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:api": "node --watch scripts/api/server.mjs",
    "dev:all": "concurrently -k -n WEB,API -c blue,green \"pnpm dev\" \"pnpm dev:api\"",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "test": "node --test scripts/secop/client.test.mjs scripts/secop/normalize.test.mjs scripts/risk/engine.test.mjs scripts/documents/safety.test.mjs scripts/documents/text.test.mjs scripts/documents/analysis.test.mjs scripts/api/reviews.test.mjs",
    "check": "pnpm lint && pnpm test && pnpm build",
    "secop:ingest": "node scripts/secop/ingest-contracts.mjs",
    "secop:entities": "node scripts/secop/resolve-entities.mjs",
    "secop:processes": "node scripts/secop/ingest-process-metrics.mjs",
    "secop:documents": "node scripts/secop/ingest-documents.mjs",
    "document:download": "node scripts/documents/download.mjs",
    "document:extract": "node scripts/documents/extract-text.mjs",
    "document:analyze": "node scripts/documents/analyze-contract.mjs",
    "document:review": "node scripts/documents/review.mjs",
    "document:pilot": "node scripts/documents/pilot-report.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/database/migrate.mjs",
    "db:import": "node scripts/database/import-contracts.mjs",
    "risk:calculate": "node scripts/risk/calculate.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@rolldown/binding-win32-x64-msvc": "^1.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
